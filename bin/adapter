#!/usr/bin/env bash
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../lib/bridge/common.sh
source "$DIR/lib/bridge/common.sh"

ACTION="${1:-status}"
ADAPTER_HOST="${SATORI_ADAPTER_HOST:-127.0.0.1}"
ADAPTER_PORT="${SATORI_ADAPTER_PORT:-3051}"
ADAPTER_SERVER="$DIR/providers/satori-adapter/server.mjs"
ADAPTER_AUTH="$DIR/providers/satori-adapter/auth.mjs"
ADAPTER_OPERATOR="$DIR/providers/satori-adapter/operator.mjs"
ADAPTER_STATE_DIR="${SATORI_ADAPTER_STATE_DIR:-$BRIDGE_STATE_DIR/satori-adapter}"
ADAPTER_PID_FILE="$BRIDGE_RUN_DIR/satori-adapter.pid"
ADAPTER_LOCK_FILE="$BRIDGE_RUN_DIR/satori-adapter.lock"
ADAPTER_LOG_FILE="${SATORI_ADAPTER_LOG_FILE:-$BRIDGE_STATE_DIR/logs/satori-adapter.log}"
ADAPTER_PUBLIC_URL="${SATORI_ADAPTER_PUBLIC_URL:-}"
ADAPTER_HEALTH_URL="http://$ADAPTER_HOST:$ADAPTER_PORT/health/ready"
ADAPTER_OAUTH_CALLBACK_URL="${SATORI_ADAPTER_OAUTH_CALLBACK_URL:-http://127.0.0.1:3052/callback}"

adapter_mcp_url() {
  if [ -n "${SATORI_ADAPTER_MCP_URL:-}" ]; then
    printf '%s\n' "$SATORI_ADAPTER_MCP_URL"
    return 0
  fi
  if [ -n "${TUNNEL_URL:-}" ]; then
    printf '%s/mcp\n' "${TUNNEL_URL%/}"
    return 0
  fi
  if [ -s "$BRIDGE_TUNNEL_URL_FILE" ]; then
    local public_url
    public_url="$(cat "$BRIDGE_TUNNEL_URL_FILE")"
    printf '%s/mcp\n' "${public_url%/}"
    return 0
  fi
  echo "public MCP URL is unavailable; set SATORI_ADAPTER_MCP_URL or start/configure the main bridge" >&2
  return 1
}

adapter_alive() {
  bridge_pidfile_alive "$ADAPTER_PID_FILE" "$ADAPTER_SERVER"
}

adapter_lock() {
  command -v flock >/dev/null 2>&1 || {
    echo "flock is required for adapter lifecycle serialization" >&2
    exit 1
  }
  exec 8>"$ADAPTER_LOCK_FILE"
  flock -w 10 8 || {
    echo "another adapter lifecycle operation is already in progress" >&2
    exit 1
  }
}

adapter_start() {
  for cmd in node curl setsid; do
    command -v "$cmd" >/dev/null 2>&1 || {
      echo "$cmd is required to start the Satori adapter" >&2
      exit 1
    }
  done
  [ -f "$ADAPTER_SERVER" ] || {
    echo "adapter server is missing: $ADAPTER_SERVER" >&2
    exit 1
  }
  [ -d "$DIR/providers/satori-adapter/node_modules/@modelcontextprotocol/sdk" ] || {
    echo "adapter dependencies are missing; run npm ci in providers/satori-adapter" >&2
    exit 1
  }

  adapter_lock
  if adapter_alive; then
    echo "Satori adapter already running on $ADAPTER_HEALTH_URL"
    return 0
  fi
  rm -f "$ADAPTER_PID_FILE"
  install -d -m 700 "$ADAPTER_STATE_DIR" "$(dirname "$ADAPTER_LOG_FILE")" "$BRIDGE_RUN_DIR"

  local mcp_url
  mcp_url="$(adapter_mcp_url 2>/dev/null || true)"

  (
    umask 077
    setsid env \
      SATORI_ADAPTER_HOST="$ADAPTER_HOST" \
      SATORI_ADAPTER_PORT="$ADAPTER_PORT" \
      SATORI_ADAPTER_STATE_DIR="$ADAPTER_STATE_DIR" \
      SATORI_ADAPTER_PUBLIC_URL="$ADAPTER_PUBLIC_URL" \
      SATORI_ADAPTER_MCP_URL="$mcp_url" \
      SATORI_ADAPTER_OAUTH_CALLBACK_URL="$ADAPTER_OAUTH_CALLBACK_URL" \
      node "$ADAPTER_SERVER" 8>&- >>"$ADAPTER_LOG_FILE" 2>&1 </dev/null &
    printf '%s\n' "$!" > "$ADAPTER_PID_FILE"
  )

  if ! bridge_wait_url "$ADAPTER_HEALTH_URL" 30 0.1 1 || ! adapter_alive; then
    echo "Satori adapter failed to become healthy; see $ADAPTER_LOG_FILE" >&2
    bridge_stop_pidfile "$ADAPTER_PID_FILE" "$ADAPTER_SERVER"
    exit 1
  fi
  echo "Satori adapter started explicitly"
  echo "  local:  $ADAPTER_HEALTH_URL"
  echo "  status: bin/adapter status"
  echo "  stop:   bin/adapter stop"
}

adapter_stop() {
  adapter_lock
  if adapter_alive; then
    bridge_stop_pidfile "$ADAPTER_PID_FILE" "$ADAPTER_SERVER"
    echo "Satori adapter stopped"
  else
    rm -f "$ADAPTER_PID_FILE"
    echo "Satori adapter already stopped"
  fi
}

adapter_status() {
  if ! adapter_alive; then
    echo "Satori adapter: stopped"
    return 1
  fi
  local pid
  pid="$(cat "$ADAPTER_PID_FILE")"
  if curl -sf -m 2 "$ADAPTER_HEALTH_URL" -o /dev/null; then
    echo "Satori adapter: running"
    echo "pid: $pid"
    echo "local health: $ADAPTER_HEALTH_URL"
    echo "public ingress: not managed by this command"
    return 0
  fi
  echo "Satori adapter: process $pid is present but health is unavailable" >&2
  return 2
}

adapter_auth_command() {
  local mode="$1"
  local mcp_url
  mcp_url="$(adapter_mcp_url)"
  [ -f "$ADAPTER_AUTH" ] || {
    echo "adapter OAuth helper is missing: $ADAPTER_AUTH" >&2
    exit 1
  }
  [ -d "$DIR/providers/satori-adapter/node_modules/@modelcontextprotocol/sdk" ] || {
    echo "adapter dependencies are missing; run npm ci in providers/satori-adapter" >&2
    exit 1
  }
  install -d -m 700 "$ADAPTER_STATE_DIR"
  umask 077
  SATORI_ADAPTER_MCP_URL="$mcp_url" \
    SATORI_ADAPTER_STATE_DIR="$ADAPTER_STATE_DIR" \
    SATORI_ADAPTER_OAUTH_CALLBACK_URL="$ADAPTER_OAUTH_CALLBACK_URL" \
    node "$ADAPTER_AUTH" "$mode"
}

adapter_issue_capability() {
  local ttl="$1"
  [ -f "$ADAPTER_OPERATOR" ] || {
    echo "adapter operator helper is missing: $ADAPTER_OPERATOR" >&2
    exit 1
  }
  install -d -m 700 "$ADAPTER_STATE_DIR"
  umask 077
  SATORI_ADAPTER_STATE_DIR="$ADAPTER_STATE_DIR" node "$ADAPTER_OPERATOR" issue "$ttl"
}

adapter_set_master_bearer() {
  [ -f "$ADAPTER_OPERATOR" ] || {
    echo "adapter operator helper is missing: $ADAPTER_OPERATOR" >&2
    exit 1
  }
  install -d -m 700 "$ADAPTER_STATE_DIR"
  umask 077
  if [ "$#" -gt 0 ]; then
    SATORI_ADAPTER_STATE_DIR="$ADAPTER_STATE_DIR" node "$ADAPTER_OPERATOR" set-master "$1"
  else
    SATORI_ADAPTER_STATE_DIR="$ADAPTER_STATE_DIR" node "$ADAPTER_OPERATOR" set-master
  fi
}

adapter_revoke_capability() {
  local capability_id="${2:-}"
  [ -n "$capability_id" ] || {
    echo "usage: bin/adapter revoke-cap <capability-id>" >&2
    exit 2
  }
  install -d -m 700 "$ADAPTER_STATE_DIR"
  umask 077
  SATORI_ADAPTER_STATE_DIR="$ADAPTER_STATE_DIR" node "$ADAPTER_OPERATOR" revoke "$capability_id"
}

case "$ACTION" in
  start) adapter_start ;;
  stop) adapter_stop ;;
  status) adapter_status ;;
  auth) adapter_auth_command auth ;;
  auth-status) adapter_auth_command status ;;
  issue-cap) adapter_issue_capability "${2:-3600}" ;;
  set-master-bearer) adapter_set_master_bearer "${@:2}" ;;
  revoke-cap) adapter_revoke_capability "$@" ;;
  *)
    echo "usage: bin/adapter start|stop|status|auth|auth-status|issue-cap [ttl-seconds]|set-master-bearer [bearer]|revoke-cap <capability-id>" >&2
    exit 2
    ;;
esac
