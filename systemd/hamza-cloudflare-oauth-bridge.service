[Unit]
Description=Hamza WSL Cloudflare OAuth MCP Bridge
Documentation=file:///home/hamza/repo/satori_bridge/README.md
ConditionPathExists=/home/hamza/repo/satori_bridge/scripts/start.sh

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/hamza/repo/satori_bridge
Environment=HOME=/home/hamza
Environment=TUNNEL_URL=https://mcp.hamza.my.id
Environment=PATH=/home/hamza/.nvm/versions/node/v24.19.0/bin:/home/hamza/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/hamza/repo/satori_bridge/scripts/start.sh
ExecStop=/home/hamza/repo/satori_bridge/scripts/stop.sh
TimeoutStartSec=180
TimeoutStopSec=60
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
