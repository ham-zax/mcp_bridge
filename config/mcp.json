{
  "$schema": "https://docs.1mcp.app/schemas/v1.0.0/mcp-config.json",
  "version": "1.0.0",
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home/hamza/repo/satori",
        "/home/hamza/repo/trufflehog"
      ],
      "tags": ["filesystem"]
    },
    "shell": {
      "command": "uvx",
      "args": ["mcp-shell-server"],
      "env": {
        "ALLOW_COMMANDS": "git,pnpm,node,npx,rg,grep,ls,cat,pwd",
        "MCP_SHELL_DEFAULT_TIMEOUT_SECONDS": "30",
        "MCP_SHELL_MAX_TIMEOUT_SECONDS": "300",
        "MCP_SHELL_OUTPUT_LIMIT_BYTES": "1048576"
      },
      "tags": ["shell"]
    }
  }
}