{
  "$schema": "https://docs.1mcp.app/schemas/v1.0.0/mcp-config.json",
  "version": "1.0.0",
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem@2026.7.10",
        "/home/hamza/repo"
      ],
      "tags": ["filesystem"]
    },
    "shell": {
      "command": "uvx",
      "args": [
        "--from",
        "mcp-shell-server==1.1.8",
        "python",
        "/home/hamza/repo/satori_bridge/scripts/mcp-shell-server.py"
      ],
      "env": {
        "ALLOW_COMMANDS": "git,pnpm,node,npx,rg,grep,ls,cat,pwd,bash,sh",
        "ALLOW_PATTERNS": ".*",
        "MCP_SHELL_ALLOW_DANGEROUS": "ALL",
        "MCP_SHELL_DEFAULT_TIMEOUT_SECONDS": "30",
        "MCP_SHELL_MAX_TIMEOUT_SECONDS": "300",
        "MCP_SHELL_OUTPUT_LIMIT_BYTES": "1048576"
      },
      "tags": ["shell"]
    }
  }
}